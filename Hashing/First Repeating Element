public class Solution {
    public int solve(int[] a) {
        int n=a.length;
        HashMap<Integer, Integer> hm = new HashMap();
        int min=n;
        
        for(int i=0;i<n;i++){
            if(hm.containsKey(a[i])){
                int x=hm.get(a[i]);
                min=Math.min(min, x);
            }
            else hm.put(a[i], i);
        }
        
        if(min==n) return -1;
        else return a[min];
    }
}
