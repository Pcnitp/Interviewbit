public class Solution {
    public int solve(String s) {
        int n=s.length();
        Stack<Integer> st = new Stack<Integer>();
        
        for(int i=0;i<n;i++){
            char c=s.charAt(i);
            if(c=='(') st.push(1);
            else{
                if(st.isEmpty()) return 0;
                else st.pop();
            }
        }
        
        if(st.isEmpty()) return 1;
        return 0;
    }
}
