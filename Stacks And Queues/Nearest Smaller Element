public class Solution {
    public int[] prevSmaller(int[] a) {
        int n = a.length;
        int[] b = new int[n];
        Stack<Integer> st = new Stack<>();
        
        for(int i=0; i<n; i++){
            while((!st.empty()) && (a[st.peek()] >= a[i])) st.pop();  
            if(st.empty()) b[i] = -1;
            else b[i] = a[st.peek()];
            st.push(i);
        }
        
        return b;
    }
}
