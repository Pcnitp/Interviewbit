public class Solution {
    
    ArrayList<ArrayList<Integer>> ans;
    
    public void solve(ArrayList<Integer> a, int b, int n, int currIndex, int currSum, ArrayList<Integer> currArray) {
        if(currIndex == n) {
            if((currSum == b) && (!ans.contains(currArray))) ans.add(currArray);
            return;
        }
        
        ArrayList<Integer> ar = new ArrayList<>(currArray);
        ar.add(a.get(currIndex));
        
        solve(a, b, n, currIndex+1, currSum, currArray);
        solve(a, b, n, currIndex+1, currSum+a.get(currIndex), ar);
    }
    
	public ArrayList<ArrayList<Integer>> combinationSum(ArrayList<Integer> a, int b) {
        int n = a.size();
        Collections.sort(a);
        ans = new ArrayList<ArrayList<Integer>>();
            
        solve(a, b, n, 0, 0, new ArrayList<Integer>());
        return ans;
	}
}
