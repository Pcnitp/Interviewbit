public class Solution {
    
    public String solve(String a, int b) {
        if(b==0) return a;
        long max=0;
        int n=a.length();
        
        for(int i=0;i<n-1;i++){
            char c=a.charAt(i);
            for(int j=1;j<n;j++){
                StringBuilder sb = new StringBuilder(a);
                sb.replace(i, i+1, Character.toString(sb.charAt(j)));
                sb.replace(j, j+1, Character.toString(c));
                String val = solve(sb.toString(), b-1);
                max = Math.max(max, Long.parseLong(val));
            }
        }
        return String.valueOf(max);
    }
}
