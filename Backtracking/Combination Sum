public class Solution {
    
    public void solve(ArrayList<Integer> a, int b, int curr, int sum, ArrayList<Integer> ar, ArrayList<ArrayList<Integer>> ans){
        int n=a.size();
        if(curr == n || sum>b) return;
        if(sum==b){
            ans.add(ar);
            return;
        }
        
        ArrayList<Integer> ar1 = new ArrayList<>(ar);
        ar1.add(a.get(curr));
        solve(a, b, curr, sum+a.get(curr), ar1, ans);
        solve(a, b, curr+1, sum, ar, ans);
    }
    
    public ArrayList<ArrayList<Integer>> combinationSum(ArrayList<Integer> a, int b) {
        int n=a.size();
        Collections.sort(a);
        
        for(int i=0;i<n-1;i++){
            if(a.get(i) == a.get(i+1)){
                a.remove(i+1);
                i--;
                n--;
            }
        }
        
        ArrayList<ArrayList<Integer>> ans = new ArrayList<>();
        ArrayList<Integer> ar = new ArrayList<>();
        solve(a, b, 0, 0, ar, ans);
        return ans;
    }
}
