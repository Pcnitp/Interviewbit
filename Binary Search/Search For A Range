public class Solution {

    public int bs(int[] a, int b, int s, int e) {
        if(e<s) return -1;
        int mid = s + (e-s)/2;
        if(a[mid] == b) return mid;
        else if(a[mid] < b) return bs(a, b, mid+1, e);
        else return bs(a, b, s, mid-1);   
    }
    
    public int[] searchRange(final int[] a, int b) {
        int in = bs(a, b, 0, a.length-1);
        int[] ans = new int[2];
        
        if(in == -1) {
            ans[0] = -1;
            ans[1] = -1;
            return ans;
        }
        
        int start = in;
        int end = in;
        
        while(start > -1 && a[start] == b) start --;
        while(end < a.length && a[end] == b) end ++;
        
        ans[0] = start+1;
        ans[1] = end-1;
        return ans;
    }
}
