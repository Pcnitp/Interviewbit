/**
 * Definition for singly-linked list.
 * class ListNode {
 *     public int val;
 *     public ListNode next;
 *     ListNode(int x) { val = x; next = null; }
 * }
 */
public class Solution {
    public ListNode insertionSortList(ListNode a) {
        ListNode b = a;
        
        while(b.next != null){
            ListNode c = b.next;
            while(c != null) {
                if(c.val < b.val) {
                    int x = b.val;
                    b.val = c.val;
                    c.val = x;
                }
                c = c.next;
            }
            
            b = b.next;
        }
        
        return a;
    }
}
