public class Solution {
    // DO NOT MODIFY THE ARGUMENTS WITH "final" PREFIX. IT IS READ ONLY
    
    public int find(int[] a, int i, int prev, int[][] dp){
        int n=a.length;
        if(i==n) return 0;
        if(prev!=-1 && dp[i][prev] != -1) return dp[i][prev];
        
        if(prev == -1 || a[i] > a[prev]){
            int x = find(a, i+1, i, dp) + 1;
            int y = find(a, i+1, prev, dp);
            return Math.max(x, y);
        }
        else dp[i][prev] = find(a, i+1, prev, dp);
        return dp[i][prev];
    }
    
    public int lis(final int[] a) {
        int n=a.length;
        int[][] dp = new int[n+1][n+1];
        for(int i=0;i<=n;i++)
            Arrays.fill(dp[i], -1);
        return find(a, 0, -1, dp);
    }
}
