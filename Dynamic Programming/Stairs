public class Solution {
    
    public int climb(int a, int[] dp){
        if(a==0) return 1;
        if(a<0) return 0;
        if(dp[a] == 0) dp[a] = climb(a-1, dp) + climb(a-2, dp);
        return dp[a];
    }
    
    public int climbStairs(int a) {
        int[] dp = new int[a+1];
        return climb(a, dp);
    }
}
