public class Solution {
    // DO NOT MODIFY THE ARGUMENTS WITH "final" PREFIX. IT IS READ ONLY
    
    public int solve(String a, String b, int i, int j, int n, int m, int[][] dp){
        if(i==n){
            while(j<m){
                if(b.charAt(j) != '*') return 0;
                j++;
            }
            
            return 1;
        }
        else if(j== m) return 0;
        
        if(dp[i][j] != -1) return dp[i][j];
        int ans = 0;
        
        if((a.charAt(i) == b.charAt(j)) || (b.charAt(j) == '?'))
            ans = solve(a, b, i+1, j+1, n, m, dp);
        else if(b.charAt(j) == '*') {
            ans = solve(a, b, i+1, j, n, m, dp);
            if(ans == 0) ans = solve(a, b, i, j+1, n, m, dp);
        }
        else ans = 0;
        
        dp[i][j] = ans;
        return ans;
    }
    
    public int isMatch(final String a, final String c) {
        int n=a.length();
        int m=c.length();
        String b = c;
        
        for(int i=0; i<m;i++){
            if(b.charAt(i) == '*'){
                int j=i;
                while(i<m && b.charAt(i) == '*') 
                    i++;
                if(i-j>1) {
                    b=b.substring(0, j+1) + b.substring(i);
                    m=m-(i-j+1);
                }
            }
        }
        m=b.length();
        int[][] dp = new int[n+1][m+1];
        
        for(int i=0;i<=n;i++)
            Arrays.fill(dp[i], -1);
        
        return solve(a, b, 0, 0, n, m, dp);
    }
}
