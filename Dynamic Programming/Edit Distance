public class Solution {
    
    public int solve(String a, String b, int i, int j, int[][] dp){
        int n=a.length();
        int m=b.length();
        if(i==n) return m-j;
        if(j==m) return n-i;
        
        if(dp[i][j] != -1) return dp[i][j];
        
        if(a.charAt(i) == b.charAt(j))
            dp[i][j] =  solve(a, b, i+1, j+1, dp);
        else{
            int x = solve(a, b, i+1, j, dp);
            int y = solve(a, b, i+1, j+1, dp);
            int z = solve(a, b, i, j+1, dp);
            dp[i][j] = 1 + Math.min(x, Math.min(y, z));
        }
        
        return dp[i][j];
    }
    
    public int minDistance(String a, String b) {
        int n=a.length();
        int m=b.length();
        int[][] dp = new int[n+1][m+1];
        for(int i=0;i<=n;i++)
            Arrays.fill(dp[i], -1);
        return solve(a.toLowerCase(), b.toLowerCase(), 0, 0, dp);
    }
}
