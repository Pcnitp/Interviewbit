public class Solution {
    public int solve(String s) {
        int n=s.length();
        int ans=0;
        int count=0;
        
        for(int i=0;i<n;i++){
            if(s.charAt(i) == '(') count++;
            else count--;
            if(count == -1){
                ans++;
                count++;
            }
        }
        
        return count+ans;
    }
}
