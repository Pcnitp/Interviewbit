public class Solution {
    // DO NOT MODIFY THE ARGUMENTS WITH "final" PREFIX. IT IS READ ONLY
    public int lengthOfLastWord(final String s) {
        int n=s.length();
        int last=0;
        for(int i=0;i<n;i++){
            if(s.charAt(i) == ' ') continue;
            last=0;
            while(i<n && s.charAt(i) != ' '){
                last++;
                i++;
            }   
        }
        return last;
    }
}
