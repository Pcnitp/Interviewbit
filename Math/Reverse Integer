public class Solution {
    public int reverse(int n) {
        long ans =0;
        int sign=1;
        if(n<0){ 
            sign=-1;
            n*=-1;
        }
        
        while(n>0){
            ans=ans*10 + n%10;
            n/=10;
        }
        
        ans= ans *sign;
        if(ans>Integer.MAX_VALUE || ans<Integer.MIN_VALUE) return 0;
        return (int)ans;
    }
}
