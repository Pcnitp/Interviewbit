public class Solution {
    public int isPalindrome(int a) {
        if(a<0) return 0;
        
        int p=(int)Math.log10(a);
        int m=(int)Math.pow(10,p);
        
        while(m>0){
            int s=a/m;
            int e=a%10;
            if(s!=e) return 0;
            a=a%m;
            a=a/10;
            m/=100;
        }
        
        return 1;
    }
}
