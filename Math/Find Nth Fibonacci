public class Solution {
    
    public long[][] mult(long[][] a, int n){
        if(n==1) return a;
        long m=1000000007;
        long[][] b=mult(a, n/2);
        long[][] c=new long[2][2];
        
        c[0][0] = ((b[0][0] * b[0][0])%m + (b[0][1] * b[1][0])%m)%m;
        c[0][1] = ((b[0][0] * b[0][1])%m + (b[0][1] * b[1][1])%m)%m;
        c[1][0] = ((b[1][0] * b[0][0])%m + (b[1][1] * b[1][0])%m)%m;
        c[1][1] = ((b[1][0] * b[0][1])%m + (b[1][1] * b[1][1])%m)%m;
        
        if(n%2==0) return c;
        long[][] d=new long[2][2];
        
        d[0][0] = ((c[0][0] * a[0][0])%m + (c[0][1] * a[1][0])%m)%m;
        d[0][1] = ((c[0][0] * a[0][1])%m + (c[0][1] * a[1][1])%m)%m;
        d[1][0] = ((c[1][0] * a[0][0])%m + (c[1][1] * a[1][0])%m)%m;
        d[1][1] = ((c[1][0] * a[0][1])%m + (c[1][1] * a[1][1])%m)%m;
        return d;
    }
    
    public int solve(int n) {
        if(n==1 || n==2) return 1;
        long[][] a= new long[2][2];
        a[0][0] = 1;
        a[0][1] = 1;
        a[1][0] = 1;
        a[1][1] = 0;
        
        long[][] b= mult(a, n-1);
        return (int)b[0][0];
    }
}
