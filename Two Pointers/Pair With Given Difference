public class Solution {
    
    public int binarySearch(int[] a, int s, int e, int key){
        int n=a.length;
        if(e<s) return -1;
        int mid=s+(e-s)/2;
        
        if(a[mid] == key) return mid;
        if(a[mid] < key) return binarySearch(a, mid+1, e, key);
        return binarySearch(a, s, mid-1, key);
    } 
    
    public int solve(int[] a, int b) {
        Arrays.sort(a);
        int n=a.length;
        b=Math.abs(b);
        
        for(int i=0;i<n;i++)
            if(binarySearch(a, i+1, n-1, a[i]+b) > 0) return 1;
        
        return 0;
    }
}
