public class Solution {
    public int removeDuplicates(ArrayList<Integer> a) {
        int n=a.size();
        int i=0, j=1;
        
        while(j<n){
            if(a.get(i).equals(a.get(j))) j++;
            else{
                i++;
                int temp=a.get(i);
                a.set(i, a.get(j));
                a.set(j, temp);
                j++;
            }
        }
        
        return i+1;
    }
}
