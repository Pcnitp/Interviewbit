public class Solution {
    public int firstMissingPositive(int[] a) {
        int n=a.length;
        for(int i=0;i<n;i++){
            if((a[i]>0) && (a[i]!=i+1) && (a[i] <n) && (a[i] != a[a[i]-1])){
                int x=a[i];
                a[i] = a[x-1];
                a[x-1]=x;
                i--;
            }
        }
        
        for(int i=0;i<n;i++)
            if(a[i] != i+1) return i+1;
        
        return n+1;
    }
}
