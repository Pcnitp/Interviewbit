public class Solution {
    public int solve(int[] a, int b) {
        int n=a.length;
        int sum=0;
        
        for(int i=0;i<b;i++)
            sum+=a[i];
        
        int max=sum;
        
        for(int i=b-1, j=n-1;i>-1;i--, j--){
            sum = sum - a[i] + a[j];
            max=Math.max(sum, max);
        }
        return max;
    }
}
