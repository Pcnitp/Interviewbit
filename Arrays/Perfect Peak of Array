public class Solution {
    public int perfectPeak(int[] a) {
        int n=a.length;
        
        int[] leftMax=new int[n];
        leftMax[0]=a[0];
        for(int i=1;i<n;i++)
            leftMax[i]=Math.max(leftMax[i-1], a[i]);
            
        int[] rightMin=new int[n];
        rightMin[n-1]=a[n-1];
        for(int i=n-2;i>-1;i--)
            rightMin[i]=Math.min(rightMin[i+1], a[i]);
            
        for(int i=1;i<n-1;i++){
            if(a[i]>leftMax[i-1] && a[i]<rightMin[i+1])
                return 1;
        }
        
        return 0;
    }
}
