public class Solution {
    public int[] solve(int[] a) {
        int n=a.length;
        int i=0, j=0;
        
        while(i<n && j<n){
            if(a[j]==0) j++;
            else if(i!=j){
                a[i]=a[j];
                a[j]=0;
                i++;
                j++;
            }
            else{
                i++;
                j++;
            }
        }
        return a;
    }
}
