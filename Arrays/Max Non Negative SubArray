public class Solution {
    public ArrayList<Integer> maxset(ArrayList<Integer> a) {
        ArrayList<Integer> b = new ArrayList();
        
        int i=0;
        int n = a.size();
        long maxSum = 0;
        
        while(i<n) {
            ArrayList<Integer> c = new ArrayList();
            long sum = 0;
            int j=i;

            while((j<n) && a.get(j) > -1){
                c.add(a.get(j));
                sum+=a.get(j);
                j++;
            }
            
            if((maxSum<sum) || (maxSum == sum && b.size() < c.size())){
               b=c;
               maxSum = sum; 
            } 
            
            i=j+1;  
        }
        
        return b;
    }
}
