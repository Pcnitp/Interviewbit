public class Solution {
    // DO NOT MODIFY THE ARGUMENTS WITH "final" PREFIX. IT IS READ ONLY
    public int[] spiralOrder(final int[][] a) {
        int m = a.length;
        if(m == 0) return new int[0];
        int n = a[0].length;
        int[] b = new int[m*n];
        
        int curr = 0;        
        int itr = 0;
        
        while(curr<b.length) {
            int minr = itr;
            int maxr = m - itr - 1;
            int minc = itr;
            int maxc = n - itr - 1;
            
            for(int i = minc; i<= maxc && curr<b.length; i++)
                b[curr++] = a[minr][i];
            
            for(int i = minr+1; i<=maxr && curr<b.length; i++)
                b[curr++] = a[i][maxc];
            
            for(int i = maxc-1; i>=minc && curr<b.length; i--)
                b[curr++] = a[maxr][i];
            
            for(int i = maxr-1; i>minr && curr<b.length; i--)
                b[curr++] = a[i][minc];
                
            itr++;
        }
        
        return b;
    }
}
