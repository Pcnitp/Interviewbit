public class Solution {
    public int[][] generateMatrix(int n) {
        int[][] a=new int[n][n];
        int x=0, num=1;
        
        while(x<Math.ceil(n/2.0)){
            for(int i=x;i<n-x;i++) a[x][i]=num++;
            for(int i=x+1;i<n-x-1;i++) a[i][n-x-1]=num++;
            for(int i=n-x-1; i>x; i--) a[n-x-1][i]=num++; 
            for(int i=n-x-1; i>x;i--) a[i][x]=num++;
            x++;
        }
        
        return a;
    }
}
