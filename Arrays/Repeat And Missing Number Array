public class Solution {
    // DO NOT MODIFY THE ARGUMENTS WITH "final" PREFIX. IT IS READ ONLY
    public int[] repeatedNumber(final int[] a) {
        int n = a.length;
        int[] ans = new int[2];
        int j=0;
        
        for(int i=0;i<n;i++){
            if(a[Math.abs(a[i])-1] >=0 ){
                a[Math.abs(a[i])-1] = -1 * a[Math.abs(a[i]) - 1];
            }
            else {
                ans[j] = Math.abs(a[i]);
                j++;
            }
                
        }
        
        for(int i=0;i<n;i++){
            if(a[i] >=0 ){
                ans[j] = i+1;
                break;
            }
        }
        
        return ans;
    }
}

