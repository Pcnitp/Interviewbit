public class Solution {
    public ArrayList<Integer> solve(ArrayList<Integer> a) {
        int n=a.size();
        int[] count=new int[1005];
        
        for(int i=0;i<n;i++)
            count[Math.abs(a.get(i))]++;
            
        ArrayList<Integer> ans=new ArrayList();
        
        for(int i=0;i<1005;i++)
            for(int j=0;j<count[i];j++)
                ans.add(i*i);
        
        return ans;
    }
}
