public class Solution {
    public int[][] prettyPrint(int n) {
        int m= 2*n -1;
        int k=n;
        int[][] a=new int[m][m];
        
        for(int i=0;i<n;i++, k--){
            for(int j=i; j<m-i; j++)
                a[i][j] = k;
            
            for(int j=i+1; j<m-i; j++)
                a[j][m-i-1] = k;
            
            for(int j=m-i-2; j>= i; j--)
                a[m-i-1][j] = k;
            
            for(int j=m-i-2; j>i; j--)
                a[j][i] = k;
        }
        
        return a;
    }
}
