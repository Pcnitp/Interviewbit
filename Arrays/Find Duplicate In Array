public class Solution {
    // DO NOT MODIFY THE ARGUMENTS WITH "final" PREFIX. IT IS READ ONLY
    public int repeatedNumber(final int[] a) {
        HashSet<Integer> hs=new HashSet();
        for(int x: a){
            if(hs.contains(x)) return x;
            hs.add(x);
        }
        return -1;
    }
}
