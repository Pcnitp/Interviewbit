public class Solution {
    public void setZeroes(ArrayList<ArrayList<Integer>> a) {
        int r=a.size();
        int c=a.get(0).size();
        
        HashSet<Integer> row=new HashSet();
        HashSet<Integer> col=new HashSet();
        
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                if(a.get(i).get(j)==0){
                    row.add(i);
                    col.add(j);
                }
            }
        }
        
        for(Integer x: row)
            for(int i=0;i<c;i++) 
                a.get(x).set(i, 0);
        
        for(Integer x: col)
            for(int i=0;i<r;i++) 
                a.get(i).set(x, 0);
        
    }
}
